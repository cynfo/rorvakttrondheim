            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 sm:gap-16 items-center">
                    
                    <!-- Image Side -->

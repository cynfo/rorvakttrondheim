                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="py-16 sm:py-32 bg-white">
            <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-10 sm:mb-16">
                    <h2 class="font-display text-3xl sm:text-5xl font-extrabold text-brand-950 mb-4 sm:mb-6">Ofte stilte spørsmål om akutt rørlegger</h2>
                    <p class="text-base sm:text-lg text-gray-600 font-light">Her er svar på det folk i Trondheim oftest lurer på i en akuttsituasjon.</p>
                </div>
                
                <div class="space-y-4">
                    <!-- FAQ 1 -->
                    <div class="bg-brand-50/50 border border-brand-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                        <button class="faq-button w-full px-5 py-5 sm:px-6 sm:py-6 text-left flex justify-between items-center focus:outline-none" aria-expanded="false" onclick="toggleFaq(this)">
                            <span class="font-display font-bold text-brand-950 text-lg sm:text-xl pr-4">Hvor raskt kan en rørlegger i Trondheim komme ved akutt vannlekkasje?</span>
                            <div class="bg-white p-1.5 sm:p-2 rounded-full shadow-sm border border-brand-100 faq-icon shrink-0">
                                <svg class="text-brand-600 w-5 h-5 sm:w-6 sm:h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                            </div>
                        </button>
                        <div class="faq-answer bg-white/50 px-5 sm:px-6 text-gray-600 font-light leading-relaxed text-base sm:text-lg border-t border-brand-100">
                            Vi har utrykning fra vår base sentralt i Trondheim, og er normalt på plass hos deg innen 30-60 minutter ved en akutt vannlekkasje, avhengig av hvor du befinner deg og trafikkbildet.
                        </div>
                    </div>
                    
                    <!-- FAQ 2 -->
                    <div class="bg-brand-50/50 border border-brand-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                        <button class="faq-button w-full px-5 py-5 sm:px-6 sm:py-6 text-left flex justify-between items-center focus:outline-none" aria-expanded="false" onclick="toggleFaq(this)">
                            <span class="font-display font-bold text-brand-950 text-lg sm:text-xl pr-4">Har dere en døgnåpen rørleggervakt?</span>

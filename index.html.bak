<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Akutt Rørlegger Trondheim - Døgnåpen Rørleggervakt 24/7</title>
    <meta name="description" content="Trenger du rørlegger akutt i Trondheim? Vi rykker ut 24/7 for vannlekkasje, tett avløp og vvs-kriser. Lokal rørleggervakt, rask responstid. Ring 92 82 82 62!">
    <meta name="keywords" content="rørlegger trondheim, akutt rørlegger trondheim, rørvakt trondheim, døgnvakt rørlegger trondheim, rørleggervakt trondheim, tett avløp trondheim, vannlekkasje trondheim, rørlegger døgnåpen trondheim">
    
    <!-- Open Graph for Social Sharing -->
    <meta property="og:title" content="Akutt Rørlegger Trondheim - Døgnåpen Rørleggervakt 24/7">
    <meta property="og:description" content="Vi rykker ut 24/7 for vannlekkasje, tett avløp og vvs-kriser. Lokal rørleggervakt i Trondheim. Ring 92 82 82 62 nå!">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://rorvakttrondheim.no/">
    <meta property="og:image" content="https://rorvakttrondheim.no/assets/hero-bg.png">
    <meta property="og:locale" content="nb_NO">

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Schema.org markup for LocalBusiness / PlumbingService -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "PlumbingService",
      "name": "Rørvakt Trondheim",
      "image": "https://rorvakttrondheim.no/assets/hero-bg.png",
      "url": "https://rorvakttrondheim.no",
      "telephone": "+4792828262",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Trondheim",
        "addressRegion": "Trøndelag",
        "postalCode": "7011",
        "addressCountry": "NO"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 63.4305,
        "longitude": 10.3951
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ],
        "opens": "00:00",
        "closes": "23:59"
      },
      "areaServed": [
        "Trondheim",
        "Byåsen",
        "Heimdal",
        "Tiller",
        "Strindheim",
        "Ranheim",
        "Malvik",
        "Melhus"
      ]
    }
    </script>
    
    <!-- FAQ Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{
        "@type": "Question",
        "name": "Hvor raskt kan en rørlegger i Trondheim komme ved akutt vannlekkasje?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vi har utrykning fra vår base sentralt i Trondheim, og er normalt på plass hos deg innen 30-60 minutter ved en akutt vannlekkasje, avhengig av hvor du befinner deg og trafikkbildet."
        }
      },{
        "@type": "Question",
        "name": "Har dere en døgnåpen rørleggervakt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, vi har en ekte døgnvakt for rørlegger-tjenester. Vi svarer telefonen 24 timer i døgnet, også på julaften, midt på natten og i helger. Vannlekkasjer tar ikke fri, og det gjør ikke vi heller."
        }
      },{
        "@type": "Question",
        "name": "Hva koster en akutt utrykning for en rørlegger i Trondheim?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Prisen for vaktutrykning varierer ut fra tidspunkt (dag, natt, helg, helligdag). Når du ringer vår rørleggervakt opplyser vi alltid tydelig om gjeldende takster for oppmøte og timepris før vi rykker ut."
        }
      },{
        "@type": "Question",
        "name": "Hvilke områder dekker deres rørservice?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vår akutte rørservice dekker hele Trondheim kommune (inkludert Byåsen, Tiller, Heimdal, Ranheim, Strindheim), samt nærliggende områder som Malvik og Melhus."
        }
      }]
    }
    </script>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb', // Royal Blue
                            700: '#1d4ed8',
                            800: '#1e40af', // Deep Blue
                            900: '#1e3a8a', // Very Dark Blue
                            950: '#172554', // Navy
                        },
                        accent: {
                            50: '#fef2f2',
                            100: '#fee2e2',
                            200: '#fecaca',
                            300: '#fca5a5',
                            400: '#f87171',
                            500: '#ef4444', 
                            600: '#dc2626', /* akutt rød */
                            700: '#b91c1c', 
                            800: '#991b1b',
                            900: '#7f1d1d',
                            950: '#450a0a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scroll behavior for smooth anchor links */
        html { scroll-behavior: smooth; }
        
        /* Prevent horizontal scroll issues on mobile */
        body { overflow-x: hidden; width: 100%; }
        
        /* Pulse animation for CTA */
        @keyframes pulse-ring {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 15px rgba(220, 38, 38, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
        }
        .animate-pulse-ring {
            animation: pulse-ring 2s infinite;
        }

        /* Float animation for decorative elements */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        .animate-float {
            animation: float 4s ease-in-out infinite;
        }

        /* FAQ Toggle Animation */
        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out, padding 0.3s ease;
        }
        .faq-answer.open {
            max-height: 600px;
            padding-top: 1rem;
            padding-bottom: 1.5rem;
        }
        .faq-icon {
            transition: transform 0.3s ease;
        }
        .faq-icon.open {
            transform: rotate(180deg);
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased pb-32 md:pb-0 selection:bg-brand-500 selection:text-white">

    <!-- HEADER -->
    <header class="bg-white/95 backdrop-blur-lg border-b border-gray-100 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16 sm:h-20">
                <div class="flex items-center gap-2 sm:gap-3">
                    <!-- Icon: Droplet in Blue -->
                    <div class="bg-gradient-to-br from-brand-500 to-brand-700 text-white p-1.5 sm:p-2 rounded-xl shadow-lg shadow-brand-500/30">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
                    </div>
                    <span class="text-xl sm:text-2xl font-display font-bold tracking-tight text-brand-950">Rørvakt<span class="text-brand-500">Trondheim</span></span>
                </div>
                <nav aria-label="Hovedmeny" class="hidden md:flex items-center gap-6">
                    <div class="text-right">
                        <p class="text-xs text-gray-500 font-medium uppercase tracking-wider mb-1">Døgnåpen vakttelefon</p>
                        <a href="tel:+4792828262" aria-label="Ring vår rørleggervakt" class="text-2xl font-display font-extrabold text-brand-950 hover:text-accent-600 transition-colors">92 82 82 62</a>
                    </div>
                    <a href="tel:+4792828262" aria-label="Ring oss" class="bg-gradient-to-r from-accent-500 to-accent-600 hover:from-accent-600 hover:to-accent-700 text-white px-7 py-3.5 rounded-xl font-bold flex items-center gap-2 transition-all hover:scale-105 shadow-xl shadow-accent-600/30">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        Ring Oss
                    </a>
                </nav>
                <!-- Mobile Only Phone Icon -->
                <a href="tel:+4792828262" aria-label="Ring oss akutt" class="md:hidden bg-gradient-to-r from-accent-500 to-accent-600 text-white p-2 rounded-lg shadow-md shadow-accent-600/30 animate-pulse-ring">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </a>
            </div>
        </div>
    </header>

    <main>
        <!-- HERO (MODERN WITH IMAGE) -->
        <section class="relative bg-brand-950 text-white pt-10 pb-16 sm:pt-32 sm:pb-36 overflow-hidden">
            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img src="assets/hero-bg.png" alt="Rørlegger rykker ut akutt i Trondheim" class="w-full h-full object-cover opacity-30 sm:opacity-40 mix-blend-luminosity filter blur-[2px] scale-105 object-center" fetchpriority="high">
                <!-- Gradients for readability -->
                <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/90 sm:via-brand-950/80 to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/50 to-brand-950/30"></div>
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center lg:text-left">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                    <div class="lg:col-span-7">
                        <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-accent-600/20 text-accent-400 font-bold text-xs sm:text-sm mb-6 sm:mb-8 border border-accent-600/30 backdrop-blur-md mx-auto lg:mx-0">
                            <span class="relative flex h-2.5 w-2.5 sm:h-3 sm:w-3">
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-400 opacity-75"></span>
                              <span class="relative inline-flex rounded-full h-2.5 w-2.5 sm:h-3 sm:w-3 bg-accent-500"></span>
                            </span>
                            PÅ VAKT I TRONDHEIM NÅ
                        </div>
                        <h1 class="font-display text-4xl sm:text-5xl lg:text-7xl font-extrabold tracking-tight mb-4 sm:mb-6 leading-tight text-white drop-shadow-md">
                            Akutt rørleggervakt <br class="hidden sm:block lg:block"> i Trondheim.
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-400 to-accent-600 block mt-1 sm:mt-2 text-3xl sm:text-4xl lg:text-5xl">Vannlekkasje eller tett avløp? Vi rykker ut 24/7.</span>
                        </h1>
                        <p class="text-base sm:text-lg lg:text-xl text-brand-100 mb-8 sm:mb-10 max-w-2xl mx-auto lg:mx-0 font-light leading-relaxed">
                            Ikke vent til skaden blir verre. Vår lokale rørlegger rykker ut umiddelbart over hele Trondheim og omegn – enten du har lekkasje, tett rør eller problemer med varmtvannsberederen.
                        </p>
                        
                        <div class="flex flex-col gap-4 mb-8 sm:mb-10 max-w-sm mx-auto lg:mx-0">
                            <a href="tel:+4792828262" aria-label="Ring 92 82 82 62 for rørleggervakt" class="w-full bg-gradient-to-r from-accent-500 to-accent-600 hover:from-accent-600 hover:to-accent-700 text-white px-6 sm:px-8 py-4 sm:py-5 rounded-2xl font-extrabold text-xl sm:text-2xl flex items-center justify-center gap-3 transition-all hover:scale-105 shadow-xl shadow-accent-600/40 animate-pulse-ring">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                Ring 92 82 82 62
                            </a>
                        </div>
                        
                        <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-5 text-sm font-medium text-brand-200 justify-center lg:justify-start">
                            <div class="flex items-center justify-center gap-2">
                                <div class="bg-brand-500/20 p-1 sm:p-1.5 rounded-full">
                                    <svg class="text-brand-400" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                </div>
                                Rask utrykning
                            </div>
                            <div class="hidden sm:block w-1.5 h-1.5 bg-brand-700 rounded-full"></div>
                            <div class="flex items-center justify-center gap-2">
                                <div class="bg-brand-500/20 p-1 sm:p-1.5 rounded-full">
                                    <svg class="text-brand-400" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                </div>
                                Lokal rørlegger
                            </div>
                            <div class="hidden sm:block w-1.5 h-1.5 bg-brand-700 rounded-full"></div>
                            <div class="flex items-center justify-center gap-2 mt-2 sm:mt-0">
                                <div class="bg-brand-500/20 p-1 sm:p-1.5 rounded-full">
                                    <svg class="text-brand-400" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                </div>
                                Døgnåpen vakt
                            </div>
                        </div>
                    </div>
                    
                    <div class="hidden lg:block lg:col-span-5 relative">
                        <!-- Glassmorphism Trust Box -->
                        <div class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 border border-white/20 shadow-2xl relative z-10 text-left animate-float">
                            <div class="absolute -top-4 -right-4 bg-accent-600 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg transform rotate-12">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg>
                            </div>
                            <h2 class="font-display text-2xl font-bold mb-6 text-white pb-4 border-b border-white/10">Klar til utrykning i Trondheim:</h2>
                            <ul class="space-y-6">
                                <li class="flex items-start gap-4">
                                    <div class="bg-white/10 p-3 rounded-2xl text-accent-400 shrink-0 border border-white/5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-white text-lg">På plass innen 60 min</h3>
                                        <p class="text-brand-100 text-sm mt-1">Vi rykker ut fra vår base sentralt for å redde boligen din fra vannskader.</p>
                                    </div>
                                </li>
                                <li class="flex items-start gap-4">
                                    <div class="bg-white/10 p-3 rounded-2xl text-accent-400 shrink-0 border border-white/5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-white text-lg">Fastpris-garanti mulig</h3>
                                        <p class="text-brand-100 text-sm mt-1">Vi er åpne om pris og takster, så du slipper overraskelser på regningen.</p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="absolute inset-0 bg-brand-500/20 blur-3xl rounded-full z-0 pointer-events-none scale-150"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TRUST BAR (MODERN) -->
        <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-10 mb-10 sm:mb-0">
            <div class="bg-white rounded-2xl shadow-xl shadow-brand-900/5 border border-gray-100 p-4 sm:p-6 md:p-8">
                <!-- Switched to grid-cols-1 on very small screens, sm:grid-cols-2, lg:grid-cols-4 for true mobile optimization -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 text-center sm:text-left divide-y sm:divide-y-0 lg:divide-x divide-gray-100">
                    <div class="flex items-center gap-4 px-2 sm:px-4 lg:px-6 pt-4 sm:pt-0 first:pt-0 first:border-0 border-t sm:border-0 border-gray-100">
                        <div class="bg-brand-50 p-2.5 sm:p-3 rounded-2xl text-brand-600 shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div class="text-left">
                            <p class="font-bold text-gray-900 font-display text-sm sm:text-base">Døgnvakt Rørlegger</p>
                            <p class="text-xs text-gray-500">Svarer hele døgnet 24/7</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 px-2 sm:px-4 lg:px-6 pt-4 sm:pt-0 border-t sm:border-0 border-gray-100">
                        <div class="bg-brand-50 p-2.5 sm:p-3 rounded-2xl text-brand-600 shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                        </div>
                        <div class="text-left">
                            <p class="font-bold text-gray-900 font-display text-sm sm:text-base">Rask utrykning</p>
                            <p class="text-xs text-gray-500">Prioriterer akutte kriser</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 px-2 sm:px-4 lg:px-6 pt-4 lg:pt-0 border-t lg:border-0 border-gray-100">
                        <div class="bg-brand-50 p-2.5 sm:p-3 rounded-2xl text-brand-600 shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <div class="text-left">
                            <p class="font-bold text-gray-900 font-display text-sm sm:text-base">Lokalkjent i Trondheim</p>
                            <p class="text-xs text-gray-500">Kjenner alle bydeler</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 px-2 sm:px-4 lg:px-6 pt-4 lg:pt-0 border-t lg:border-0 border-gray-100">
                        <div class="bg-brand-50 p-2.5 sm:p-3 rounded-2xl text-brand-600 shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
